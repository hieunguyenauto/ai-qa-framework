# ============================================================
# Copy to .env: cp .env.example .env — .env stays on this machine, NEVER commit it (it is in .gitignore).
# Write values right after '=', no spaces, no quotes.
# Login IDs come from env/<ENV>.json › accounts → only passwords live here.
# ============================================================

# Environment (file name in env/): demo
ENV=demo

# Browser: chromium (Playwright's, default) | chrome | msedge
BROWSER_CHANNEL=chromium

# Password of every demo account. The demo site shows it publicly on its login page ("Password for all users").
SHOP_PASSWORD=

# Optional: a different password for one role — SHOP_<ROLE>_PASSWORD (e.g. SHOP_STANDARD_PASSWORD=)

# Optional: override baseUrl of env/<ENV>.json
# BASE_URL=

# Optional: Basic Auth for environments that declare httpAuth in env/<ENV>.json
# HTTP_AUTH_PASSWORD=
